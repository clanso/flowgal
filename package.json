{
  "name": "flowgal",
  "version": "0.2.0",
  "description": "FlowGal：DSH Tavern / SillyTavern 的视觉小说插件。正文先流式输出，后台导演把每轮整理成视觉小说场景并从你自己的曲库里选配乐；柏宝绘式自动配图、角色外貌库、背景与立绘生成。",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/clanso/flowgal.git" },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "client.js", "dist", "manifest.json", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview-server.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": { "dsh": ">=0.1.0-rc.8 <0.2.0" }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "keywords": ["flowgal", "dsh", "dsh-tavern", "galgame", "visual-novel", "novelai", "comfyui", "plugin"]
}
